# Copy to .env (never commit .env) and fill in TEST keys for local development.
# On Render, set the same names under the service's Environment tab instead. See docs/PAYMENTS.md.

# Stripe > Developers > API keys (sk_test_... while testing)
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role key: full database access, server only
SUPABASE_SERVICE_ROLE_KEY=

# optional: the site's public address for Stripe's return links, e.g. https://power-booster-gp.onrender.com
PUBLIC_URL=
